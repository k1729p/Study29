<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<appender name="STDOUT"
		class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<!--
			<pattern>%d{HH:mm:ss.SSS} %-5level %mdc{context} %logger %msg%n%rEx</pattern>
			-->
			<pattern>%msg%n</pattern>
		</encoder>
	</appender>
	<logger name="com.datastax.oss.driver" level="WARN" />
	<logger name="com.zaxxer.hikari" level="WARN" />
	<logger name="org.mongodb.driver.cluster" level="WARN" />
	<logger name="org.mongodb.driver.connection" level="WARN" />
	<logger name="org.mongodb.driver.client" level="WARN" />
	<root level="INFO">
		<appender-ref ref="STDOUT" />
	</root>
</configuration>